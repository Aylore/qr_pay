# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qrpay

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Encryption key for storing gateway API keys (32 bytes, base64-encoded)
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Our app base URL (used for webhook callbacks from mock gateway)
APP_BASE_URL=http://localhost:8000

# Mock payment gateway config (simulating Amazon Payment Services)
MOCK_GATEWAY_BASE_URL=http://localhost:8000/mock-gateway
MOCK_GATEWAY_SECRET=mock-gateway-webhook-secret

# Foodics webhook secret (used to verify incoming webhooks)
FOODICS_WEBHOOK_SECRET=foodics-webhook-secret
